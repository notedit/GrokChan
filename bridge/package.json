{
  "name": "grokchan-bridge",
  "version": "0.1.0",
  "description": "GrokChan Cloudflare Worker bridge: web/device chat bridge to a Grok Bot webhook routine.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "gen:sim": "node scripts/gen-sim-assets.mjs",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "smoke:elevenlabs": "node scripts/elevenlabs-smoke.mjs",
    "smoke:elevenlabs:worker": "node scripts/elevenlabs-worker-smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@types/node": "^22.19.1",
    "playwright-core": "^1.64.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.152.0"
  }
}
